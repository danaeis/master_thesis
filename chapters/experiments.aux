\@writefile{lot}{\contentsline {table}{\numberline {4-5}{\ignorespaces مقایسه با روش‌های موجود روی مجموعه‌ی متناظر (\lr {$n=26$} بررسی، \lr {$574$} سه‌تایی) و همان خط‌کش ارزیابی. برچسب \lr {[}هم‌ترازشده\lr {]} یعنی روش روی \emph  {خروجی پیش‌پردازش این پایان‌نامه} اجرا شده و \lr {[}خام\lr {]} یعنی روی حجم اصلی. ستون زمان، میانه‌ی زمان اجرای هر جفت فاز بر حسب ثانیه روی همان \LRE {۲۶} بررسی است؛ زمان دو ردیف صلب از اجرای ابلیشن تابع هدف با تابع هدف یکسان گرفته شده است.}}{99}{table.caption.107}\protected@file@percent }
\newlabel{tab:reg-compare}{{4-5}{99}{مقایسه با روش‌های موجود روی مجموعه‌ی متناظر (\lr {$n=26$} بررسی، \lr {$574$} سه‌تایی) و همان خط‌کش ارزیابی. برچسب \lr {[}هم‌ترازشده\lr {]} یعنی روش روی \emph {خروجی پیش‌پردازش این پایان‌نامه} اجرا شده و \lr {[}خام\lr {]} یعنی روی حجم اصلی. ستون زمان، میانه‌ی زمان اجرای هر جفت فاز بر حسب ثانیه روی همان \عدد {۲۶} بررسی است؛ زمان دو ردیف صلب از اجرای ابلیشن تابع هدف با تابع هدف یکسان گرفته شده است}{table.caption.107}{}}
\bidi@finalfootnoteperpage{111}{0}
\@writefile{lot}{\contentsline {table}{\numberline {4-6}{\ignorespaces دایس فرسوده به تفکیک گروه اندام، به‌صورت میانه، روی همان مجموعه‌ی متناظر جدول~\ref {tab:reg-compare}. گروه پارانشیمی شامل کبد، طحال، دو کلیه، پانکراس و کیسه‌ی صفرا (\LRE {۳۱۷} سه‌تایی)، گروه عروقی شامل آئورت و بزرگ‌سیاهرگ زیرین (\LRE {۱۱۰} سه‌تایی) و گروه اسکلتی شامل مهره‌های کمری \lr {L1} تا \lr {L3} (\LRE {۱۴۷} سه‌تایی) است. همه‌ی روش‌های غیرصلب روی خروجی پیش‌پردازش این پایان‌نامه اجرا شده‌اند. نشانه‌ی $\dagger $ یعنی آن روش در آزمون علامت زوجی به‌طور معنادار از روش پیشنهادی بهتر است و $\ddagger $ یعنی بدتر؛ آستانه‌ی معناداری با تصحیح بونفرونی برای سه گروه \LRE {۰٫۰۱۷} است. این نشانه‌ها از آزمون زوجی می‌آیند و نه از مقایسه‌ی میانه‌ها.}}{100}{table.caption.109}\protected@file@percent }
\newlabel{tab:reg-organ-group}{{4-6}{100}{دایس فرسوده به تفکیک گروه اندام، به‌صورت میانه، روی همان مجموعه‌ی متناظر جدول~\ref {tab:reg-compare}. گروه پارانشیمی شامل کبد، طحال، دو کلیه، پانکراس و کیسه‌ی صفرا (\عدد {۳۱۷} سه‌تایی)، گروه عروقی شامل آئورت و بزرگ‌سیاهرگ زیرین (\عدد {۱۱۰} سه‌تایی) و گروه اسکلتی شامل مهره‌های کمری \lr {L1} تا \lr {L3} (\عدد {۱۴۷} سه‌تایی) است. همه‌ی روش‌های غیرصلب روی خروجی پیش‌پردازش این پایان‌نامه اجرا شده‌اند. نشانه‌ی $\dagger $ یعنی آن روش در آزمون علامت زوجی به‌طور معنادار از روش پیشنهادی بهتر است و $\ddagger $ یعنی بدتر؛ آستانه‌ی معناداری با تصحیح بونفرونی برای سه گروه \عدد {۰٫۰۱۷} است. این نشانه‌ها از آزمون زوجی می‌آیند و نه از مقایسه‌ی میانه‌ها}{table.caption.109}{}}
\bidi@finalfootnoteperpage{112}{0}
\@writefile{lot}{\contentsline {table}{\numberline {4-7}{\ignorespaces دایس فرسوده به تفکیک اندام، به‌صورت میانه، روی همان مجموعه‌ی متناظر؛ همه‌ی روش‌های غیرصلب روی خروجی پیش‌پردازش این پایان‌نامه اجرا شده‌اند و \lr {uGI} مخفف \lr {uniGradICON} است. دو ستون آخر مقایسه‌ی زوجی روش پیشنهادی با \lr {uniGradICON} را گزارش می‌کنند: شمار سه‌تایی‌هایی که روش پیشنهادی در آن‌ها بهتر و بدتر است، و مقدار \lr {$p$} آزمون علامت. چون این مقایسه برای یازده اندام تکرار شده، آستانه‌ی معناداری با تصحیح بونفرونی \LRE {۰٫۰۰۴۵} است و مقادیری که از آن عبور می‌کنند با نشانه‌ی $\ast $ مشخص شده‌اند.}}{101}{table.caption.110}\protected@file@percent }
\newlabel{tab:reg-organ}{{4-7}{101}{دایس فرسوده به تفکیک اندام، به‌صورت میانه، روی همان مجموعه‌ی متناظر؛ همه‌ی روش‌های غیرصلب روی خروجی پیش‌پردازش این پایان‌نامه اجرا شده‌اند و \lr {uGI} مخفف \lr {uniGradICON} است. دو ستون آخر مقایسه‌ی زوجی روش پیشنهادی با \lr {uniGradICON} را گزارش می‌کنند: شمار سه‌تایی‌هایی که روش پیشنهادی در آن‌ها بهتر و بدتر است، و مقدار \lr {$p$} آزمون علامت. چون این مقایسه برای یازده اندام تکرار شده، آستانه‌ی معناداری با تصحیح بونفرونی \عدد {۰٫۰۰۴۵} است و مقادیری که از آن عبور می‌کنند با نشانه‌ی $\ast $ مشخص شده‌اند}{table.caption.110}{}}
\bidi@finalfootnoteperpage{113}{0}
\@writefile{lot}{\contentsline {table}{\numberline {4-8}{\ignorespaces اثر پیش‌پردازش این پایان‌نامه بر دقت روش‌های موجود. مقایسه‌ی زوجی روی سه‌تایی‌های متناظر؛ دایس فرسوده به‌صورت میانه.}}{102}{table.caption.112}\protected@file@percent }
