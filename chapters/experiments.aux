\@writefile{lot}{\contentsline {table}{\numberline {4-5}{\ignorespaces مقایسه با روش‌های موجود روی مجموعه‌ی مشترک (\LRE {۲۶} بررسی، \LRE {۵۷۴} مورد مقایسه) با خط‌کش ارزیابی یکسان. همه‌ی ستون‌ها مقدار معمول‌اند؛ برای دایس مقدار بیشتر و برای بقیه‌ی ستون‌ها مقدار کمتر بهتر است. تاخوردگی برای روش صلب بنا به تعریف صفر است. زمان به‌ازای هر جفت فاز است؛ زمان مسیر صلب از اجرای همان تابع هدف در جدول~\ref {tab:reg-objective} و زمان ردیف \lr {B}-اسپلاین مجموع زمان مسیر صلب و این گذر است. زمان \lr {DEEDS} (قرمز) شامل بازسازی میدان جابه‌جایی برای سنجش تاخوردگی است و با اندازه‌گیری رویه‌ی «سنجش هزینه‌ی محاسباتی» بخش~\ref {sec:m-reg} جایگزین می‌شود. خروجی مسیر صلب از اجرایی گرفته شده که گام هم‌ترازی درشت مرکز جرم هنوز در آن فعال بود؛ حذف این گام تفاوت معناداری در دقت ایجاد نمی‌کند (جدول~\ref {tab:reg-ablation}).}}{103}{table.caption.109}\protected@file@percent }
\newlabel{tab:reg-compare}{{4-5}{103}{مقایسه با روش‌های موجود روی مجموعه‌ی مشترک (\عدد {۲۶} بررسی، \عدد {۵۷۴} مورد مقایسه) با خط‌کش ارزیابی یکسان. همه‌ی ستون‌ها مقدار معمول‌اند؛ برای دایس مقدار بیشتر و برای بقیه‌ی ستون‌ها مقدار کمتر بهتر است. تاخوردگی برای روش صلب بنا به تعریف صفر است. زمان به‌ازای هر جفت فاز است؛ زمان مسیر صلب از اجرای همان تابع هدف در جدول~\ref {tab:reg-objective} و زمان ردیف \lr {B}-اسپلاین مجموع زمان مسیر صلب و این گذر است. زمان \lr {DEEDS} (قرمز) شامل بازسازی میدان جابه‌جایی برای سنجش تاخوردگی است و با اندازه‌گیری رویه‌ی «سنجش هزینه‌ی محاسباتی» بخش~\ref {sec:m-reg} جایگزین می‌شود. خروجی مسیر صلب از اجرایی گرفته شده که گام هم‌ترازی درشت مرکز جرم هنوز در آن فعال بود؛ حذف این گام تفاوت معناداری در دقت ایجاد نمی‌کند (جدول~\ref {tab:reg-ablation})}{table.caption.109}{}}
\bidi@finalfootnoteperpage{118}{0}
\@writefile{lot}{\contentsline {table}{\numberline {4-6}{\ignorespaces دایس به تفکیک گروه اندام (مقدار معمول) روی مجموعه‌ی مشترک: اندام‌های نرم \LRE {۳۱۷}، رگ‌های بزرگ \LRE {۱۱۰} و مهره‌ها \LRE {۱۴۷} مورد مقایسه. روش‌های موجود روی خروجی پیش‌پردازش این پایان‌نامه اجرا شده‌اند. نشانه‌ی $\dagger $ یعنی آن روش در مقایسه‌ی مورد به مورد به‌طور معنادار از مسیر صلب پیشنهادی \emph  {بهتر} است و $\ddagger $ یعنی \emph  {بدتر}؛ آستانه‌ی معناداری پس از تصحیح برای سه گروه \LRE {۰٫۰۱۷} است. نبودن نشانه یعنی تفاوت معنادار نیست.}}{104}{table.caption.111}\protected@file@percent }
\newlabel{tab:reg-organ-group}{{4-6}{104}{دایس به تفکیک گروه اندام (مقدار معمول) روی مجموعه‌ی مشترک: اندام‌های نرم \عدد {۳۱۷}، رگ‌های بزرگ \عدد {۱۱۰} و مهره‌ها \عدد {۱۴۷} مورد مقایسه. روش‌های موجود روی خروجی پیش‌پردازش این پایان‌نامه اجرا شده‌اند. نشانه‌ی $\dagger $ یعنی آن روش در مقایسه‌ی مورد به مورد به‌طور معنادار از مسیر صلب پیشنهادی \emph {بهتر} است و $\ddagger $ یعنی \emph {بدتر}؛ آستانه‌ی معناداری پس از تصحیح برای سه گروه \عدد {۰٫۰۱۷} است. نبودن نشانه یعنی تفاوت معنادار نیست}{table.caption.111}{}}
\bidi@finalfootnoteperpage{119}{0}
\@writefile{lot}{\contentsline {table}{\numberline {4-7}{\ignorespaces دایس به تفکیک اندام (مقدار معمول) روی مجموعه‌ی مشترک؛ روش‌های موجود روی خروجی پیش‌پردازش این پایان‌نامه اجرا شده‌اند. سه ستون آخر مسیر صلب را مورد به مورد با \lr {uniGradICON} مقایسه می‌کنند: شمار مواردی که مسیر صلب بهتر و بدتر است و مقدار $p$. چون این مقایسه برای یازده اندام تکرار شده، آستانه‌ی معناداری پس از تصحیح \LRE {۰٫۰۰۴۵} است و مقادیری که از آن عبور می‌کنند با $\ast $ مشخص شده‌اند.}}{105}{table.caption.112}\protected@file@percent }
\newlabel{tab:reg-organ}{{4-7}{105}{دایس به تفکیک اندام (مقدار معمول) روی مجموعه‌ی مشترک؛ روش‌های موجود روی خروجی پیش‌پردازش این پایان‌نامه اجرا شده‌اند. سه ستون آخر مسیر صلب را مورد به مورد با \lr {uniGradICON} مقایسه می‌کنند: شمار مواردی که مسیر صلب بهتر و بدتر است و مقدار $p$. چون این مقایسه برای یازده اندام تکرار شده، آستانه‌ی معناداری پس از تصحیح \عدد {۰٫۰۰۴۵} است و مقادیری که از آن عبور می‌کنند با $\ast $ مشخص شده‌اند}{table.caption.112}{}}
\bidi@finalfootnoteperpage{120}{0}
\@writefile{lot}{\contentsline {table}{\numberline {4-8}{\ignorespaces اثر پیش‌پردازش این پایان‌نامه بر چهار روش هم‌ترازسازی موجود، روی حدود \LRE {۵۸۰} مورد مقایسه از \LRE {۲۶} بررسی. «شکست» یعنی دایس کمتر از \LRE {۰٫۵} و «خطای بزرگ» یعنی خطای مرکز اندام بیش از \LRE {۱۰} میلی‌متر. ستون «تغییر مورد به مورد» برای دایس شمار مواردی را می‌دهد که با پیش‌پردازش بهتر و بدتر شده‌اند، و برای دو شاخص دیگر شمار شکست‌ها یا خطاهای بزرگی که رفع شده و شمار آن‌هایی که تازه پدید آمده‌اند. مقدار $p$ از آزمون علامت روی همین دو شمار به دست آمده است.}}{106}{table.caption.114}\protected@file@percent }
\newlabel{tab:reg-frontend}{{4-8}{106}{اثر پیش‌پردازش این پایان‌نامه بر چهار روش هم‌ترازسازی موجود، روی حدود \عدد {۵۸۰} مورد مقایسه از \عدد {۲۶} بررسی. «شکست» یعنی دایس کمتر از \عدد {۰٫۵} و «خطای بزرگ» یعنی خطای مرکز اندام بیش از \عدد {۱۰} میلی‌متر. ستون «تغییر مورد به مورد» برای دایس شمار مواردی را می‌دهد که با پیش‌پردازش بهتر و بدتر شده‌اند، و برای دو شاخص دیگر شمار شکست‌ها یا خطاهای بزرگی که رفع شده و شمار آن‌هایی که تازه پدید آمده‌اند. مقدار $p$ از آزمون علامت روی همین دو شمار به دست آمده است}{table.caption.114}{}}
\bidi@finalfootnoteperpage{121}{0}
\@writefile{lot}{\contentsline {table}{\numberline {4-9}{\ignorespaces اثر پیش‌پردازش به تفکیک دشواری مورد روی حجم خام، برای موارد مقایسه‌ی هر چهار روش جدول~\ref {tab:reg-frontend} به‌صورت یک‌جا. ستون آخر شمار مواردی است که با پیش‌پردازش نیز دایس کمتر از \LRE {۰٫۵} دارند.}}{107}{table.caption.115}\protected@file@percent }
