\@writefile{lot}{\contentsline {table}{\numberline {4-10}{\ignorespaces ارقام گزارش‌شده در مقاله‌ها در برابر ارقام همان مدل‌ها روی \LRE {۶۳} حجم آزمون این پایان‌نامه. ارقام مقاله‌ها از جدول~\ref {tab:phasedet-metrics} آمده‌اند و کد فاز همان کد آن جدول است. مجموعه‌ی آزمون این پایان‌نامه فاز تأخیری ندارد و مدل‌هایی که بدون بازآموزی اجرا شده‌اند با خروجی چهارکلاسه‌ی خود سنجیده شده‌اند، یعنی پیش‌بینی فاز تأخیری خطا شمرده شده است؛ پس دو ستون عددی تنها درون هر سطر و با قید شرایط متفاوت مقایسه‌پذیرند.}}{108}{table.caption.119}\protected@file@percent }
\newlabel{tab:phase-reported}{{4-10}{108}{ارقام گزارش‌شده در مقاله‌ها در برابر ارقام همان مدل‌ها روی \عدد {۶۳} حجم آزمون این پایان‌نامه. ارقام مقاله‌ها از جدول~\ref {tab:phasedet-metrics} آمده‌اند و کد فاز همان کد آن جدول است. مجموعه‌ی آزمون این پایان‌نامه فاز تأخیری ندارد و مدل‌هایی که بدون بازآموزی اجرا شده‌اند با خروجی چهارکلاسه‌ی خود سنجیده شده‌اند، یعنی پیش‌بینی فاز تأخیری خطا شمرده شده است؛ پس دو ستون عددی تنها درون هر سطر و با قید شرایط متفاوت مقایسه‌پذیرند}{table.caption.119}{}}
