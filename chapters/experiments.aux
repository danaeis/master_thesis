\@writefile{lot}{\contentsline {table}{\numberline {4-4}{\ignorespaces مقایسه‌ی چهار تابع هدف برای پالایش صلب روی \LRE {۵۷۷} مورد مقایسه. ستون «محاسبه روی» نشان می‌دهد معیار روی کل تصویر یا فقط روی نقاب اندام‌ها محاسبه می‌شود. دایس و خطای مرکز اندام مقدار معمول‌اند؛ ستون آخر درصد موارد شکست (دایس کمتر از \LRE {۰٫۵}) است.}}{101}{table.caption.107}\protected@file@percent }
