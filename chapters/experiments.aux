\@writefile{lot}{\contentsline {table}{\numberline {4-11}{\ignorespaces گذر اختیاری \lr {B}-اسپلاین در برابر مسیر صلب پیشنهادی روی مجموعه‌ی مشترک. دایس به‌صورت مقدار معمول است. دو ستون «بهتر» و «بدتر» شمار مواردی را می‌دهند که گذر غیرصلب در آن‌ها دایس بالاتر یا پایین‌تری از خروجی صلب دارد (موارد برابر کنار گذاشته شده‌اند) و ستون آخر مقدار $p$ است. آستانه‌ی معناداری پس از تصحیح برای سه گروه \LRE {۰٫۰۱۷} و برای یازده اندام \LRE {۰٫۰۰۴۵} است و مقادیری که از آن عبور می‌کنند با $\ast $ مشخص شده‌اند.}}{110}{table.caption.118}\protected@file@percent }
\newlabel{tab:reg-bspline}{{4-11}{110}{گذر اختیاری \lr {B}-اسپلاین در برابر مسیر صلب پیشنهادی روی مجموعه‌ی مشترک. دایس به‌صورت مقدار معمول است. دو ستون «بهتر» و «بدتر» شمار مواردی را می‌دهند که گذر غیرصلب در آن‌ها دایس بالاتر یا پایین‌تری از خروجی صلب دارد (موارد برابر کنار گذاشته شده‌اند) و ستون آخر مقدار $p$ است. آستانه‌ی معناداری پس از تصحیح برای سه گروه \عدد {۰٫۰۱۷} و برای یازده اندام \عدد {۰٫۰۰۴۵} است و مقادیری که از آن عبور می‌کنند با $\ast $ مشخص شده‌اند}{table.caption.118}{}}
