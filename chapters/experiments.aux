\@writefile{lot}{\contentsline {table}{\numberline {4-9}{\ignorespaces مقایسه‌ی طبقه‌بند اندامی با روش‌های منتشرشده روی \LRE {۶۳} حجم آزمون. فاصله‌ی اطمینان \LRE {۹۵} درصد با قلم کوچک‌تر زیر هر مقدار آمده است. کد فاز همان کد جدول~\ref {tab:phasedet-metrics} است: \LRE {۰} بدون‌کنتراست، \LRE {۱} شریانی و \LRE {۲} وریدی. خروجی چهارکلاسه‌ی مدل‌هایی که روی داده‌ی دیگر آموزش دیده‌اند، به سه فاز موجود در مجموعه‌ی آزمون محدود شده است.}}{106}{table.caption.117}\protected@file@percent }
\newlabel{tab:phase-baselines}{{4-9}{106}{مقایسه‌ی طبقه‌بند اندامی با روش‌های منتشرشده روی \عدد {۶۳} حجم آزمون. فاصله‌ی اطمینان \عدد {۹۵} درصد با قلم کوچک‌تر زیر هر مقدار آمده است. کد فاز همان کد جدول~\ref {tab:phasedet-metrics} است: \عدد {۰} بدون‌کنتراست، \عدد {۱} شریانی و \عدد {۲} وریدی. خروجی چهارکلاسه‌ی مدل‌هایی که روی داده‌ی دیگر آموزش دیده‌اند، به سه فاز موجود در مجموعه‌ی آزمون محدود شده است}{table.caption.117}{}}
