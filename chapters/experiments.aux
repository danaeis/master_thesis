\@writefile{lof}{\contentsline {figure}{\numberline {4-1}{\ignorespaces شبکه‌ی بازاستفاده‌ی موارد میان مجموعه‌داده‌های عمومی سی‌تی شکمی. هر گره یک مجموعه‌داده است و اندازه‌ی آن با شمار سری‌های سی‌تی متناسب است؛ آبی یعنی تماماً اصیل، نارنجی یعنی ترکیبی از موارد اصیل و بازاستفاده، و قرمز یعنی تماماً بازاستفاده. هر پیکان از مجموعه‌داده‌ی منبع به مجموعه‌ی مشتقی می‌رود که موارد آن را به کار گرفته است. برگرفته از~\cite  {danaei2026abdomenctreview}.}}{92}{figure.caption.92}\protected@file@percent }
\newlabel{fig:review-reuse}{{4-1}{92}{شبکه‌ی بازاستفاده‌ی موارد میان مجموعه‌داده‌های عمومی سی‌تی شکمی. هر گره یک مجموعه‌داده است و اندازه‌ی آن با شمار سری‌های سی‌تی متناسب است؛ آبی یعنی تماماً اصیل، نارنجی یعنی ترکیبی از موارد اصیل و بازاستفاده، و قرمز یعنی تماماً بازاستفاده. هر پیکان از مجموعه‌داده‌ی منبع به مجموعه‌ی مشتقی می‌رود که موارد آن را به کار گرفته است. برگرفته از~\cite {danaei2026abdomenctreview}}{figure.caption.92}{}}
