\contentsline {table}{\numberline {2-1}{\ignorespaces مدل‌های بخش‌بندی و مطالعات شکاف بین‌فازی. ستون «فاز داده‌ی آموزش» نشان می‌دهد مدل با کدام فاز(ها) آموزش دیده است؛ کنار هم گذاشتن آن با دو ستون \lr {Dice}، نشان می‌دهد شکاف بین‌فازی عمدتاً پیامد ترکیب داده‌ی آموزش است، نه خاصیت ذاتی فاز بدون‌کنتراست.}}{13}{table.caption.7}%
\contentsline {table}{\numberline {2-2}{\ignorespaces مدل‌های تشخیص فاز کنتراست. ستون «معیار اصلی» سنجه‌ای است که مطالعه ادعای خود را بر آن بنا کرده؛ ستون‌های درون‌سازمانی و برون‌سازمانی عمداً از هم جدا شده‌اند تا افت تعمیم‌پذیری دیده شود.}}{21}{table.caption.14}%
\contentsline {table}{\numberline {2-3}{\ignorespaces روش‌های منتخب ثبت تصویر: وظیفه‌ای که روش برای آن معرفی شده، معیاری که روش آن را بهینه می‌کند، و مقادیر گزارش‌شده روی محک ارزیابی. روش‌های بنیادین پیش از \LRE {۲۰۰۵}، به‌دلیل نبودِ عدد قابل‌مقایسه، تنها در متن بررسی شده‌اند.}}{31}{table.caption.27}%
\contentsline {table}{\numberline {2-4}{\ignorespaces ادبیات سنتز \lr {NC}-به-\lr {CE}، دسته‌بندی‌شده بر اساس خانواده‌ی روش. ستون «فاز داده‌ی آموزش» نشان می‌دهد آیا داده‌ی آموزش هر دو فاز را به‌صورت جفت‌شده در بر داشته است یا نه. سلول‌های \lr {[عدد؟]} مقادیری‌اند که متن مقاله در دسترس نبوده یا جدول نتایج آن به‌صورت تصویر ذخیره شده و باید دستی استخراج شوند.}}{40}{table.2.4}%
\addvspace {10\p@ }
\contentsline {table}{\numberline {3-1}{\ignorespaces هفت مقوله‌ی چارچوب ارزیابی ریسک سوگیری، به همراه تعریف عملیاتی و تهدید مرتبه‌بالاتری که هر مقوله به آن مربوط است.}}{48}{table.caption.41}%
\addvspace {10\p@ }
\contentsline {table}{\numberline {4-1}{\ignorespaces شمار مجموعه‌داده‌های دارای ریسک بالا در هر مقوله، از مجموع \LRE {۲۲} مجموعه‌داده‌ی ارزیابی‌شده.}}{69}{table.caption.86}%
\contentsline {table}{\numberline {4-2}{\ignorespaces ابلیشن گام‌به‌گام پایپ‌لاین. دایس فرسوده به‌صورت میانه \lr {[}چارک اول--چارک سوم\lr {]}؛ فاصله‌ها بر حسب میلی‌متر و به‌صورت میانه. \lr {$n=26$} بررسی، \lr {$55$} جفت فاز.}}{72}{table.caption.92}%
\contentsline {table}{\numberline {4-3}{\ignorespaces ابلیشن تابع هدف با مدل تبدیل و مقداردهی اولیه‌ی یکسان. تنها ردیف دوم دامنه‌ی معیار را به نقاب محدود \emph {نمی‌کند}.}}{73}{table.caption.94}%
\contentsline {table}{\numberline {4-4}{\ignorespaces مقایسه با روش‌های موجود روی همان ورودی و همان خط‌کش ارزیابی. ستون تاخوردگی تنها برای روش‌های غیرصلب معنا دارد.}}{74}{table.caption.96}%
